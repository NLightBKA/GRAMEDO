{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run GRAMEDO Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "npm: compile",
      "env": {
        "NODE_ENV": "development"
      }
    }
  ]
}
